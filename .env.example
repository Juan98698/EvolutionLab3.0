# Public browser configuration (anon key; never a service role key).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Optional browser integrations.
VITE_SENTRY_DSN=
VITE_VAPID_PUBLIC_KEY=
# Server only. Configure in the deployment provider; never prefix with VITE_.

SUPABASE_SERVICE_ROLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
APP_PRODUCTION_ORIGIN=https://evolutionlab.fit
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_TEST_BUYER_EMAIL=
MERCADOPAGO_WEBHOOK_URL=https://evolutionlab.fit/api/mercadopago-webhook

VAPID_PRIVATE_KEY=
EXTRA_ALLOWED_ORIGINS=

# Maintenance only: do not configure these in the public deployment.
# Use a separate, empty Supabase project for the restore rehearsal.
SOURCE_DATABASE_URL=
SOURCE_DATABASE_PASSWORD=""
RESTORE_DATABASE_URL=
RESTORE_DATABASE_PASSWORD=""
RESTORE_SUPABASE_URL=
RESTORE_SUPABASE_SERVICE_ROLE_KEY=
RESTORE_SUPABASE_ANON_KEY=
