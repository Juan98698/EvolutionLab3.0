{
  "name": "evolution-lab-3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-production-bundle.mjs",
    "build:analyze": "npm run typecheck && node scripts/analyze.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "dev:e2e": "node scripts/e2e-server.mjs",
    "test:run": "node scripts/test.mjs run --maxWorkers=2",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json",
    "test:performance": "playwright test --config=playwright.performance.config.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/react": "^10.68.0",
    "@supabase/supabase-js": "^2.39.8",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.2",
    "chart.js": "^4.4.2",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/web-push": "^3.6.3",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "shx": "^0.4.0",
    "typescript": "^5.2.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "@types/node": "^22.0.0",
    "deepmerge": "file:vendor/safe-deepmerge"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "workbox-build": {
      "glob": "^14.0.6"
    },
    "deepmerge": "$deepmerge"
  }
}
